# Version control
.git
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
.venv
venv/

# Editor
.vscode/

# Env & secrets — never bake these into the image; set them in Render's dashboard
.env
.env.*

# Local database & runtime data — not needed in the image, DB comes via DATABASE_URL
db.sqlite3
*.sqlite3

# Media uploads — user-generated, should not be baked into the image
media/

# Build artifacts — regenerated by collectstatic during the build
staticfiles/

# Misc
*.log
.DS_Store